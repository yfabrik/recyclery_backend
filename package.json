{
  "name": "recyclerie-backend",
  "version": "1.0.0",
  "description": "Backend pour le système de gestion de recyclerie",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "lint": "eslint .",
    "jest": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.config.cjs --runInBand",
    "mocha": "mocha",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.config.cjs --runInBand --coverage=false",
    "db:migrate": "sequelize-cli db:migrate --options-path .sequelizerc",
    "db:smoke-bak-migrations": "node scripts/smokeBakMigrations.cjs",
    "db:migrate-data": "tsx src/scripts/migrateToMariadb.ts",
    "db:smoke": "tsx src/scripts/smokeMariaDb.ts",
    "db:repair-orphans": "tsx src/scripts/repairDbOrphans.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.21",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "mariadb": "^3.5.3",
    "node-cron": "^4.2.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^5.1.7",
    "winston": "^3.18.3",
    "zod": "^4.3.5",
    "@recyclerie/api": "git+ssh://git@github.com/yfabrik/api-recyclerie.git#v0.5.1"

  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.1",
    "@eslint/json": "^0.14.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "babel-jest": "^30.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jest": "^29.1.0",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "mocha": "^11.7.5",
    "nodemon": "^3.1.10",
    "prettier": "3.8.1",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1"
  }
}
