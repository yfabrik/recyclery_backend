# =============================================================================
# Recyclerie backend — environment variables
# Copy this file to .env and fill in values before starting the app.
# =============================================================================

# --- Required ----------------------------------------------------------------

# Secret used to sign and verify JWT tokens. The app refuses to start without it.
JWT_SECRET=change-me-to-a-long-random-string

# --- Runtime -----------------------------------------------------------------

# development | test | production
NODE_ENV=development

# --- Database ----------------------------------------------------------------

# Production only (see config/config.json). Sequelize reads this connection string.
# Development uses SQLite at ./database/database2.sqlite (no env var needed).
# DB_URL=sqlite:./database/production.sqlite

# --- Bootstrap admin (optional) ----------------------------------------------

# When the database has no users, create an admin account with these values.
# All three must be set for bootstrap to run.
# DEFAULT_USERNAME=admin
# DEFAULT_MAIL=admin@example.com
# DEFAULT_PASS=change-me

# --- Rate limiting (optional) ------------------------------------------------

# Global API rate limit window in milliseconds (default: 900000 = 15 minutes)
# RATE_LIMIT_WINDOW_MS=900000

# Max requests per IP per window for /api/ (default: 1000)
# RATE_LIMIT_MAX_REQUESTS=1000

# Comma-separated IPs exempt from rate limiting (localhost is always skipped)
# RATE_LIMIT_WHITELIST=
